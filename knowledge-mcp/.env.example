# Copy to .env in this directory. The server and ingestion load it automatically.
QDRANT_URL=http://127.0.0.1:6333
DENSE_COLLECTION=documents
MODEL_NAME=intfloat/multilingual-e5-small
# Bind to 127.0.0.1 by default. Use 0.0.0.0 only behind an authenticated proxy.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Set to an existing local directory or a read-only mounted share.
KNOWLEDGE_ROOT=/path/to/knowledge/root
# Optional: defaults to knowledge-mcp/.state
# INGESTION_BASE_DIR=/var/lib/knowledge-mcp
# Optional: defaults to knowledge-mcp/mcp/index-policy.yaml
# POLICY_FILE=/opt/ai-knowledgeagent-mcp/knowledge-mcp/mcp/index-policy.yaml

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MIN_CHUNK_LENGTH=80
EMBED_BATCH_SIZE=32
